{
  "opencollection": "1.0.0",
  "info": {
    "name": "Star Therapeutics Content Oembed API",
    "version": "wp/v2"
  },
  "items": [
    {
      "info": {
        "name": "oembed",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an oEmbed response for a star-therapeutics.com URL",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://star-therapeutics.com/wp-json/oembed/1.0/embed",
            "params": [
              {
                "name": "url",
                "value": "",
                "type": "query",
                "description": "The URL of the resource for which to fetch oEmbed data."
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "The oEmbed format to use."
              },
              {
                "name": "maxwidth",
                "value": "",
                "type": "query",
                "description": "The maximum width of the embed frame in pixels."
              }
            ]
          },
          "docs": "The oEmbed 1.0 provider endpoint. Returns provider name, title, author, thumbnail and an iframe embed for any URL on star-therapeutics.com."
        }
      ]
    }
  ],
  "bundled": true
}